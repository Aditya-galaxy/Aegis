{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Least-privilege containment access for Kronagent. Install this only after reviewing the actions below; Kronagent operates read-only without it.",
  "Parameters": {
    "KronagentAccountId": {
      "Type": "String",
      "Description": "Kronagent's AWS account id \u2014 the only principal permitted to assume this role.",
      "AllowedPattern": "^\\d{12}$"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "The per-tenant External ID from your Kronagent console. Without it this role could be assumed on behalf of any Kronagent customer.",
      "MinLength": 16,
      "MaxLength": 1224,
      "NoEcho": true
    },
    "QuarantineSecurityGroupId": {
      "Type": "String",
      "Description": "The quarantine security group. This role may move an instance into this group and no other.",
      "AllowedPattern": "^sg-[0-9a-f]+$"
    },
    "QuarantineNaclId": {
      "Type": "String",
      "Description": "The network ACL Kronagent may add deny entries to. This role can modify no other NACL.",
      "AllowedPattern": "^acl-[0-9a-f]+$"
    },
    "RoleName": {
      "Type": "String",
      "Default": "KronagentContainRole",
      "Description": "Name of the IAM role to create."
    }
  },
  "Resources": {
    "KronagentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "RoleName"
        },
        "Description": "Least-privilege containment access for Kronagent. Install this only after reviewing the actions below; Kronagent operates read-only without it.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${KronagentAccountId}:root"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KronagentContainPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DisableAndReenableAccessKeys",
                  "Effect": "Allow",
                  "Action": "iam:UpdateAccessKey",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/*"
                  }
                },
                {
                  "Sid": "QuarantineDenyAllInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": [
                    "iam:PutUserPolicy",
                    "iam:DeleteUserPolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PolicyName": "kronagent-quarantine-deny-all"
                    }
                  }
                },
                {
                  "Sid": "RevokeRoleSessionsInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": [
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PolicyName": "kronagent-revoke-sessions"
                    }
                  }
                },
                {
                  "Sid": "ReadStateForRollbackCapture",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:DescribeNetworkAcls"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "ec2:Region": {
                        "Fn::Sub": "${AWS::Region}"
                      }
                    }
                  }
                },
                {
                  "Sid": "IsolateInstanceIntoQuarantineSG",
                  "Effect": "Allow",
                  "Action": "ec2:ModifyInstanceAttribute",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:security-group/${QuarantineSecurityGroupId}"
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "ec2:Region": {
                        "Fn::Sub": "${AWS::Region}"
                      }
                    }
                  }
                },
                {
                  "Sid": "BlockIpAtQuarantineNacl",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkAclEntry",
                    "ec2:DeleteNetworkAclEntry"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:network-acl/${QuarantineNaclId}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "ec2:Region": {
                        "Fn::Sub": "${AWS::Region}"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "Paste this back into Kronagent to finish the contain connection",
      "Value": {
        "Fn::GetAtt": [
          "KronagentRole",
          "Arn"
        ]
      }
    }
  }
}
