{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kronagent Active Containment Cross-Account IAM Role for Automated Remediation",
  "Parameters": {
    "KronagentAccountId": {
      "Type": "String",
      "Description": "AWS Account ID of the Kronagent platform (e.g. 123456789012)",
      "AllowedPattern": "^\\d{12}$"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "Unique secret External ID provided by Kronagent for your tenant",
      "MinLength": 16,
      "MaxLength": 1224
    },
    "QuarantineSecurityGroupId": {
      "Type": "String",
      "Description": "Id of the quarantine security group. Kronagent may move an instance into this group and no other.",
      "AllowedPattern": "^sg-[0-9a-f]+$"
    },
    "QuarantineNaclId": {
      "Type": "String",
      "Description": "Id of the network ACL Kronagent may add deny entries to. This role can modify no other NACL.",
      "AllowedPattern": "^acl-[0-9a-f]+$"
    },
    "RoleName": {
      "Type": "String",
      "Default": "KronagentContainRole",
      "Description": "Name of the IAM role to create"
    }
  },
  "Resources": {
    "KronagentContainRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "RoleName"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:aws:iam::${KronagentAccountId}:root"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KronagentContainPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DisableAndReenableAccessKeys",
                  "Effect": "Allow",
                  "Action": "iam:UpdateAccessKey",
                  "Resource": {
                    "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:user/*"
                  }
                },
                {
                  "Sid": "QuarantineDenyAllInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": [
                    "iam:PutUserPolicy",
                    "iam:DeleteUserPolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:user/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PolicyName": "kronagent-quarantine-deny-all"
                    }
                  }
                },
                {
                  "Sid": "RevokeRoleSessionsInlinePolicyOnly",
                  "Effect": "Allow",
                  "Action": [
                    "iam:PutRolePolicy",
                    "iam:DeleteRolePolicy"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PolicyName": "kronagent-revoke-sessions"
                    }
                  }
                },
                {
                  "Sid": "ReadStateForRollbackCapture",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:DescribeNetworkAcls"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "IsolateEc2InstanceSecurityGroup",
                  "Effect": "Allow",
                  "Action": "ec2:ModifyInstanceAttribute",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:security-group/${QuarantineSecurityGroupId}"
                    }
                  ]
                },
                {
                  "Sid": "BlockIpNaclEntry",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateNetworkAclEntry",
                    "ec2:DeleteNetworkAclEntry"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:network-acl/${QuarantineNaclId}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "ARN of the created Kronagent Contain IAM Role. Copy this back to Kronagent console.",
      "Value": {
        "Fn::GetAtt": [
          "KronagentContainRole",
          "Arn"
        ]
      }
    }
  }
}
